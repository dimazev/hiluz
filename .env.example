# copy to .env and set your real domain (used for canonical URL, sitemap, share links, structured data)
DOMAIN=https://your-domain.co.il
# host port the container is published on
PORT=8080

# ---- SEO monitoring (seo/check.mjs, run daily by ./seo/cron.sh install) ----
# Google Search Console: a service-account JSON key; add its client_email as a user (Restricted is enough) in Search Console.
# GSC_SITE is the property exactly as Search Console shows it: https://your-domain.co.il/  or  sc-domain:your-domain.co.il
GSC_KEY_FILE=
GSC_SITE=
# PageSpeed Insights API key (free, optional; avoids rate limits)
PSI_API_KEY=
# SerpAPI key for daily keyword positions (optional, paid)
SERPAPI_KEY=
# keywords to track, comma separated
SEO_QUERIES=חילוץ שטח,חילוצי שטח,חילוץ ג׳יפ,חילוץ רייזר,חילוץ מחול,חילוץ 4x4
