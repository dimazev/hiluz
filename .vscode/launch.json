{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch site (F5)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/serve.mjs",
      "args": ["8080"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
